generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Membre du staff pouvant acceder au dashboard.
model StaffUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String?
  discordId    String?   @unique
  discordTag   String?
  role         String    @default("MODERATEUR") // MODERATEUR | ADMIN
  approved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  reviewed Candidature[] @relation("ReviewedBy")
  articles Article[]     @relation("AuteurArticle")
}

/// Article du blog. Redige depuis le dashboard staff, publie sur /blog.
model Article {
  id      String @id @default(cuid())
  /// Identifiant lisible dans l'URL. Genere depuis le titre, editable ensuite :
  /// le changer casse les liens deja partages, d'ou le champ explicite.
  slug    String @unique
  titre   String
  /// Resume affiche en liste et dans les metadonnees Open Graph.
  extrait String
  /// Corps de l'article en Markdown restreint (voir src/lib/markdown.ts).
  contenu String

  couverture  String? // URL d'image, hebergee ailleurs
  epingle     Boolean @default(false)
  statut      String  @default("BROUILLON") // BROUILLON | PUBLIE

  /// Date affichee et utilisee pour le tri. Renseignee a la premiere
  /// publication, puis conservee meme si l'article repasse en brouillon.
  publieLe  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auteur   StaffUser? @relation("AuteurArticle", fields: [auteurId], references: [id], onDelete: SetNull)
  auteurId String?

  @@index([statut, publieLe])
}

/// Candidature au recrutement. Les deux parcours ne remplissent pas les memes
/// champs : ceux propres a un poste sont donc optionnels.
model Candidature {
  id     String @id @default(cuid())
  status String @default("EN_ATTENTE") // EN_ATTENTE | ACCEPTEE | REFUSEE
  poste  String @default("STAFF")      // STAFF | ANIMATEUR

  // Communs aux deux parcours. L'age n'est pas stocke : il se deduit de la
  // date de naissance et serait faux des l'anniversaire suivant.
  discordTag       String
  prenom           String
  dateNaissance    String
  ancienneteOmerta String
  motivation       String

  // Parcours staff
  disponibilite      String?
  heuresFiveM        String?
  serveursJoues      String?
  experienceStaff    String?
  activiteServeur    String?
  historiqueSanction String?
  decouverteServeur  String?
  pourquoiToi        String?
  pubOuLive          String?

  // Parcours animation
  presentationIRL     String?
  experienceAnimation String?
  exemplesEvenements  String?
  plaisirAnimation    String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  noteStaff  String?

  reviewedBy   StaffUser? @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?

  @@index([status, createdAt])
  @@index([poste, status])
}
