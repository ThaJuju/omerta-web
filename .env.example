# Base de donnees PostgreSQL — meme provider en developpement et en production.
# Adapter l'utilisateur, le mot de passe et le nom de base a votre installation.
DATABASE_URL="postgresql://omerta_web_user:motdepasse@127.0.0.1:5432/omerta_web?schema=public"

# Secret de signature des sessions staff — generer avec: openssl rand -base64 32
SESSION_SECRET="changez-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum"

# Webhooks Discord recevant les candidatures (JAMAIS cote client).
# Un salon par poste ; DISCORD_WEBHOOK_URL sert de repli si l'un manque.
DISCORD_WEBHOOK_STAFF=""
DISCORD_WEBHOOK_ANIMATEUR=""
DISCORD_WEBHOOK_URL=""

# Roles Discord notifies a l\'arrivee d\'une candidature.
# Identifiant numerique du role ; vide = aucune notification.
DISCORD_ROLE_STAFF=""
DISCORD_ROLE_ANIMATEUR=""

# Connexion staff via Discord OAuth (optionnel)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""

# Statut serveur FiveM
FIVEM_SERVER_URL="https://c90l6t8d.gen.addveo.com:443"
FIVEM_SERVER_ID="gad36ex"

# Liens externes
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/omertarp"
NEXT_PUBLIC_SHOP_URL="https://boutique.omerta-rp.fr/"
NEXT_PUBLIC_RULES_URL="https://reglement.omerta-rp.fr/"
NEXT_PUBLIC_SITE_URL="https://omerta-rp.fr"

# Uniquement pour une instance de developpement servie en http sur une IP de
# LAN : leve le drapeau Secure du cookie de session, qu'un navigateur refuse
# d'enregistrer sur une origine en clair (la connexion staff boucle alors sur
# /staff/login). NE JAMAIS poser sur la VM de production : le jeton de session
# circulerait en clair sur le reseau.
COOKIE_NON_SECURISE=""
